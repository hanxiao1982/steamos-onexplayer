# 在真机上用 collect-dmi.sh 填这些值，不要猜。
# oxpec 匹配的是 board_vendor + board_name。
# InputPlumber 匹配的是 sys_vendor + product_name。两边经常不一样。

OXP_BOARD_VENDOR=ONE-NETBOOK
OXP_BOARD_NAME=ONEXPLAYER NEWMODEL
OXP_BOARD_VARIANT=oxp_fly

OXP_SYS_VENDOR=ONE-NETBOOK
OXP_PRODUCT_NAME=ONEXPLAYER NEWMODEL

# oxp_fly  = F1 / F1Pro / APEX（风扇 0x76，Turbo 0xF1）
# oxp_x1   = X1 系列（风扇 0x58，Turbo 0xEB）
# oxp_2    = 2 系列
# oxp_g1_a / oxp_g1_i = G1 / SUPER X
