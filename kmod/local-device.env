# Legacy single-device placeholder. Prefer kmod/devices/<slug>.env
# (collect-dmi.sh --add). Do not overwrite BOARD_NAME here to switch models.
# Placeholder values are skipped by the injector.
# oxpec matches board_vendor + board_name; InputPlumber matches sys_vendor + product_name.

OXP_BOARD_VENDOR=ONE-NETBOOK
OXP_BOARD_NAME=ONEXPLAYER NEWMODEL
OXP_BOARD_VARIANT=oxp_fly

OXP_SYS_VENDOR=ONE-NETBOOK
OXP_PRODUCT_NAME=ONEXPLAYER NEWMODEL

# oxp_fly  = F1 / F1Pro / APEX (fan 0x76, Turbo 0xF1)
# oxp_x1   = X1 series (fan 0x58, Turbo 0xEB)
# oxp_2    = 2 series
# oxp_g1_a / oxp_g1_i = G1 / SUPER X
