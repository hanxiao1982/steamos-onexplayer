# Copy to <slug>.env in this directory. Do not keep the name example.env
# (the injector skips it). On a new handheld: kmod/scripts/collect-dmi.sh --add
# Or copy this file and edit BOARD_NAME / PRODUCT_NAME / VARIANT.

OXP_BOARD_VENDOR=ONE-NETBOOK
OXP_BOARD_NAME=ONEXPLAYER NEWMODEL
OXP_BOARD_VARIANT=oxp_fly

OXP_SYS_VENDOR=ONE-NETBOOK
OXP_PRODUCT_NAME=ONEXPLAYER NEWMODEL

# InputPlumber capability map: oxp8 ≈ APEX, oxp5 ≈ X1
OXP_CAP_MAP=oxp8

# oxp_wmi  = Intel OxpWMI (X2 Mini / X2 / OXP3 / Apex Air) — build linux/oxp-wmi, no oxpec inject
# oxp_fly  = F1 / F1Pro / APEX (fan 0x76, Turbo 0xF1)
# oxp_x1   = X1 series (fan 0x58, Turbo 0xEB)
# oxp_2    = 2 series
# oxp_g1_a / oxp_g1_i = G1 / SUPER X
# OXP_EC_STACK=oxp-wmi|oxpec  (optional; oxp_wmi variant sets oxp-wmi)
