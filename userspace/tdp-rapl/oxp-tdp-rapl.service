[Unit]
Description=OneXPlayer Intel RAPL TdpLimit1 for steamos-manager
After=dbus.service
# Do not claim com.steampowered.OxpRapl.Tdp until a *non-root*
# steamos-manager exists (26.3 deadlocks if the name is owned at user-daemon
# start). Detection is via /proc; root cannot query the session bus.

[Service]
Type=simple
ExecStart=/usr/local/sbin/oxp-tdp-rapl
Restart=on-failure
RestartSec=2
# RAPL power_limit_uw is root-only.
User=root

[Install]
WantedBy=multi-user.target
